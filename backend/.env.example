# Copy this file to ".env" and fill in your values.
# Atlas: Database > Connect > Drivers > copy the "mongodb+srv://..." string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=food_ordering
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# Comma-separated list of frontend origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000
